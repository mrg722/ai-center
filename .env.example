# ─────────────────────────────────────────────────────────────────────────────
# AI Command Center — environment. Copy to .env.local (never commit it).
# `npm run setup:env` generates .env.local with random secrets for you.
# Full reference: docs/ENVIRONMENT.md
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (used in docs / bridge instructions)
APP_URL=http://localhost:3000

# Database. Empty → embedded Postgres (PGlite) in ./.data for local dev.
# Supabase: Project Settings → Database → Connection string (URI).
#   Long-running server: direct connection (port 5432).
#   Vercel/serverless:   transaction pooler (port 6543) + DATABASE_POOL_MAX=1
DATABASE_URL=
# PGLITE_DIR=.data/pglite
# DATABASE_POOL_MAX=5
# ACC_AUTO_MIGRATE=true

# Auth — required. 32+ random chars. Rotating it signs everybody out.
SESSION_SECRET=
# One-time token required by /setup to create the first moderator.
SETUP_TOKEN=

# Scheduler secret for /api/cron/tick (Vercel Cron sends it automatically)
CRON_SECRET=
# Run the hosted-agent worker in-process (default: true in dev, false in prod)
# ACC_INPROCESS_WORKER=true

# Characters of context sent to an agent per run (minimum-context rule)
# CONTEXT_BUDGET_CHARS=24000

# ─── GitHub (server-side only) ───────────────────────────────────────────────
# Fine-grained PAT: Contents RO, Pull requests RW, Metadata RO (+ Issues RO)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ─── Hosted AI providers (server-side only; the browser never sees them) ────
# Vercel AI Gateway: one key unlocks the Gateway model catalogue.
AI_GATEWAY_API_KEY=
# VERCEL_AI_GATEWAY_MODEL=openai/gpt-5.6-luna
# Only the providers you use need a key. Bridge agents (Claude Code, Codex)
# use their own CLI login on your machine instead.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# OPENAI_MODEL=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
DASHSCOPE_API_KEY=
# OLLAMA_MODEL=qwen2.5-coder
# LMSTUDIO_MODEL=
