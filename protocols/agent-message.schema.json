{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mensaje de agente del AI Command Center",
  "type": "object",
  "required": [
    "message_id",
    "task_id",
    "from_agent",
    "message_type",
    "content",
    "created_at"
  ],
  "properties": {
    "message_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "from_agent": {
      "type": "string"
    },
    "to_agent": {
      "type": ["string", "null"]
    },
    "message_type": {
      "enum": [
        "TASK",
        "REQUEST",
        "REVIEW",
        "QUESTION",
        "ANSWER",
        "WARNING",
        "ERROR",
        "PROPOSAL",
        "APPROVAL_REQUEST",
        "STATUS",
        "RESULT",
        "HANDOFF"
      ]
    },
    "content": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reply_to": {
      "type": ["string", "null"]
    },
    "priority": {
      "enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"]
    },
    "requires_action": {
      "type": "boolean"
    },
    "requires_approval": {
      "type": "boolean"
    },
    "git_branch": {
      "type": ["string", "null"]
    },
    "git_commit": {
      "type": ["string", "null"]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}
